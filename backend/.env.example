PORT=3001
NODE_ENV=development
# Prefer "Session pooler" URI from Supabase Dashboard → Database → Connection string
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
TEST_DATABASE_URL=
FRONTEND_ORIGIN=http://localhost:5173
CRON_SECRET=change-me-to-a-long-random-string
STORE_BASE_URL=https://demo.inelabteamdev.com
SCRAPER_STRATEGY=browser
HEADLESS=true
MAX_ATTEMPTS=3
BACKOFF_BASE_MS=2000
CHAOS_MODE=false
LOG_LEVEL=info
